# Copy to .env. Never commit real credentials.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/mahalaxmi?retryWrites=true&w=majority
JWT_SECRET=replace-with-at-least-32-random-characters
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=replace-with-at-least-12-characters
# Required: the owner's verified shop pin (no assumed coordinates in live mode)
STORE_LAT=19.01199
STORE_LNG=72.84950
APP_ORIGIN=http://localhost:3000
PORT=3000
NODE_ENV=development
# / means real same-origin Express API. Omit only for the isolated demo build.
VITE_API_URL=/
# Product uploads persist here. Use a persistent disk path on a cloud host.
UPLOAD_DIR=uploads
# Set only after checking your host's reverse proxy topology.
TRUST_PROXY_HOPS=1
