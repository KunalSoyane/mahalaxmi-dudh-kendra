      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test('New SKU visible',()=>pm.expect(pm.response.json().some(p=>p.id===pm.environment.get('sku'))).to.be.true);"
            ]
          }
        }
