    {
      "name": "Customer registration",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\"name\": \"Lab Customer\", \"email\": \"{{customerEmail}}\", \"password\": \"{{customerPassword}}\", \"role\": \"admin\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.environment.set('customerCookie',pm.response.headers.get('Set-Cookie').split(';')[0]);",
              "pm.test('Cannot self-promote to admin',()=>pm.expect(pm.response.json().role).to.eql('customer'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Customer cannot change inventory",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Cookie",
            "value": "{{customerCookie}}"
          }
        ],
        "url": "{{baseUrl}}/api/admin/products/{{sku}}",
        "body": {
          "mode": "raw",
          "raw": "{\"price\": 1}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 403\", () => pm.response.to.have.status(403));"
            ]
          }
        }
      ]
    },
    {
      "name": "Inside delivery radius",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Cookie",
            "value": "{{adminCookie}}"
          }
        ],
        "url": "{{baseUrl}}/api/delivery/check",
        "body": {
          "mode": "raw",
          "raw": "{\"lat\": 19.0085, \"lng\": 72.8467}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test('Eligible',()=>pm.expect(pm.response.json().eligible).to.be.true);"
            ]
          }
        }
      ]
    },
    {
      "name": "Outside delivery radius",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
