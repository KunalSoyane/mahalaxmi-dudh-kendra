            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test('Ineligible',()=>pm.expect(pm.response.json().eligible).to.be.false);"
            ]
          }
        }
      ]
    },
    {
      "name": "Checkout uses server price",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Cookie",
            "value": "{{customerCookie}}"
          }
        ],
        "url": "{{baseUrl}}/api/orders",
        "body": {
          "mode": "raw",
          "raw": "{\"items\": [{\"id\": \"{{sku}}\", \"quantity\": 2, \"price\": 1}], \"address\": {\"name\": \"Lab Customer\", \"phone\": \"9876543210\", \"street\": \"Test address, not a real delivery\"}, \"location\": {\"lat\": 19.0085, \"lng\": 72.8467}}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.environment.set('orderId',pm.response.json().id);",
              "pm.test('Server total is 89',()=>pm.expect(pm.response.json().total).to.eql(89));"
            ]
          }
        }
      ]
    },
